# Скопируйте этот файл в .env (в корень проекта, рядом с pom.xml) и укажите свой пароль.
# .env читают и docker compose, и Spring Boot (через spring.config.import).
# Формат строго KEY=VALUE: без кавычек, без пробелов вокруг "=", без слова export.

DB_PASSWORD=your_password_here
JWT_SECRET=your_secret_key_at_least_32_chars